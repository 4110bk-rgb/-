# Bitrix24 incoming webhook base URL (from CRM > Developer resources > Other > Inbound webhook)
# Format: https://YOUR_PORTAL.bitrix24.ru/rest/USER_ID/WEBHOOK_CODE/
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# How many days back to pull data for the reports
REPORT_DAYS=30

# Port for the dashboard server
PORT=3000

# MAX messenger bot token (from @MasterBot after creating your bot)
MAX_BOT_TOKEN=

# Yandex.Disk OAuth token (from https://oauth.yandex.ru/, app with "Яндекс.Диск REST API" scope)
# used for daily project backups
YANDEX_DISK_TOKEN=

# Yandex.Metrika + Yandex.Direct OAuth token (app with "Яндекс.Метрика" and "Яндекс.Директ API" scopes)
YANDEX_ADS_TOKEN=
